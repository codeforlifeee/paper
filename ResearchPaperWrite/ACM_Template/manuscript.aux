\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces End-to-end architectural workflow of the proposed Spectral-Guided Spatial Cross-Attention Fusion Network (SGSCF-Net). The model processes raw hyperspectral cubes through two coordinated stages: Stage\nonbreakingspace I executes input-level spectral gating (SBAM) on raw patches and orthogonal dual-branch feature learning (CBSA) across spectral residual blocks; Stage\nonbreakingspace II performs spectral-to-spatial compression, second-order spatial-channel covariance fusion (SCFG), and spatial residual learning, concluding with Global Average Pooling (GAP) and minority-aware hybrid loss supervision.}}{6}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:sgscf_overall}{{1}{6}{End-to-end architectural workflow of the proposed Spectral-Guided Spatial Cross-Attention Fusion Network (SGSCF-Net). The model processes raw hyperspectral cubes through two coordinated stages: Stage~I executes input-level spectral gating (SBAM) on raw patches and orthogonal dual-branch feature learning (CBSA) across spectral residual blocks; Stage~II performs spectral-to-spatial compression, second-order spatial-channel covariance fusion (SCFG), and spatial residual learning, concluding with Global Average Pooling (GAP) and minority-aware hybrid loss supervision}{figure.caption.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Spectral Band Attention Module (SBAM)}{6}{subsection.3.2}\protected@file@percent }
